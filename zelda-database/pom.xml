<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kgomc.zelda</groupId>
        <artifactId>zelda-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>zelda-database</artifactId>
    <packaging>jar</packaging>

    <name>Zelda :: Database</name>
    <description>
        HikariCP-backed database module — async query builder, transactions,
        multi-database migrations, and advisory locking.
        Supports PostgreSQL, MySQL, and SQLite.
        Platform-agnostic: depends only on zelda-core and pure JDBC.
    </description>

    <dependencies>

        <!-- Shared kernel (no platform dependency) -->
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-core</artifactId>
        </dependency>

        <!-- Connection pooling -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!--
            JDBC Drivers — optional at compile time.
            Only the driver matching your database.json "type" is needed at runtime.
            Include whichever you use in your plugin's shaded JAR.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JSON config parsing (database.json) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

    </dependencies>

</project>