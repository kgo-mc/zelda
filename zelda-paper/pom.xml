<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kgomc.zelda</groupId>
        <artifactId>zelda-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>zelda-paper</artifactId>
    <packaging>jar</packaging>

    <name>Zelda :: Paper Adapter</name>
    <description>
        Adapts Paper/Spigot/Bukkit's JavaPlugin to the ZeldaPlugin interface.
        This is the only Zelda module that imports Paper — all other modules
        remain platform-agnostic through ZeldaPlugin.
    </description>

    <dependencies>

        <!-- Core — provides the ZeldaPlugin interface -->
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-core</artifactId>
        </dependency>

        <!--
            Paper API — provided by the server at runtime.
            This is the ONLY module in the Zelda library that touches Paper.
        -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>

        <!--
            ConfigLib Paper — adds Bukkit type serializers (ItemStack, Location, etc.)
            on top of configlib-yaml which zelda-configuration already pulls in.
            When consumers depend on zelda-paper, they get the full Paper-aware
            ConfigLib automatically — ConfigurationRegistry.buildSharedProperties()
            detects BukkitConfigurationProperties at runtime and uses it.
        -->
        <dependency>
            <groupId>de.exlll</groupId>
            <artifactId>configlib-paper</artifactId>
        </dependency>

    </dependencies>

</project>