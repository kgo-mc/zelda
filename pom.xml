<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.kgomc.zelda</groupId>
    <artifactId>zelda-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Zelda :: Parent</name>
    <description>Parent POM for the Zelda modular Minecraft library</description>

    <!-- =========================================================
         Distribution — GitHub Packages (open source, restricted access)
         Consumers need a PAT with read:packages scope in settings.xml
    ========================================================== -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>Zelda GitHub Packages</name>
            <url>https://maven.pkg.github.com/kgomc/zelda</url>
        </repository>
    </distributionManagement>

    <!-- =========================================================
         Modules
    ========================================================== -->
    <modules>
        <module>zelda-core</module>
        <module>zelda-paper</module>
        <module>zelda-velocity</module>
        <module>zelda-database</module>
        <module>zelda-configuration</module>
        <module>zelda-messaging</module>
        <module>zelda-ui</module>
        <module>zelda-injection</module>
        <module>zelda-outbox</module>
        <module>zelda-builder</module>
    </modules>

    <!-- =========================================================
         Properties — single source of truth for ALL versions
    ========================================================== -->
    <properties>
        <!-- Java -->
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Platforms -->
        <paper.version>1.21.4-R0.1-SNAPSHOT</paper.version>
        <velocity.version>3.3.0-SNAPSHOT</velocity.version>

        <!-- ConfigLib (JitPack requires the "v" prefix on the artifact version) -->
        <configlib.version>4.8.1</configlib.version>

        <!-- Database -->
        <hikari.version>5.1.0</hikari.version>
        <postgresql.version>42.7.4</postgresql.version>
        <mysql.version>9.1.0</mysql.version>
        <sqlite.version>3.47.1.0</sqlite.version>
        <gson.version>2.11.0</gson.version>

        <!-- UI -->
        <invui.version>1.49</invui.version>
        <papi.version>2.11.6</papi.version>

        <!-- RxJava -->
        <rxjava.version>3.1.10</rxjava.version>

        <!-- Injection -->
        <feather.version>1.0</feather.version>

        <!-- Testing -->
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <feather.version>1.0</feather.version>

        <!-- Build plugins -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <!-- =========================================================
         Dependency Management
         Child modules declare deps WITHOUT versions — inherited here.
    ========================================================== -->
    <dependencyManagement>
        <dependencies>

            <!-- Internal modules -->
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-paper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-velocity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-database</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-configuration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-injection</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kgomc.zelda</groupId>
                <artifactId>zelda-ui</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Platforms (provided — supplied by the server/proxy at runtime) -->
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>${paper.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>com.velocitypowered</groupId>
                <artifactId>velocity-api</artifactId>
                <version>${velocity.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- ConfigLib -->
            <dependency>
                <groupId>com.github.Exlll.ConfigLib</groupId>
                <artifactId>configlib-paper</artifactId>
                <version>v${configlib.version}</version>
            </dependency>

            <!-- ConfigLib — use configlib-yaml for platform-agnostic modules,
                             configlib-paper if you need Bukkit type serializers -->
            <dependency>
                <groupId>de.exlll</groupId>
                <artifactId>configlib-yaml</artifactId>
                <version>${configlib.version}</version>
            </dependency>
            <dependency>
                <groupId>de.exlll</groupId>
                <artifactId>configlib-paper</artifactId>
                <version>${configlib.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikari.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>

            <!-- Feather DI (Maven Central) -->
            <dependency>
                <groupId>org.codejargon.feather</groupId>
                <artifactId>feather</artifactId>
                <version>${feather.version}</version>
            </dependency>

            <!-- RxJava -->
            <dependency>
                <groupId>io.reactivex.rxjava3</groupId>
                <artifactId>rxjava</artifactId>
                <version>${rxjava.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- =========================================================
         Build — plugin versions locked here, applied to all modules
    ========================================================== -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
                <!-- Declared here but only zelda-builder activates it -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>