<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.kgomc.zelda</groupId>
        <artifactId>zelda-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>zelda-builder</artifactId>
    <packaging>jar</packaging>

    <name>Zelda :: Builder</name>
    <description>
        Entry point and shaded assembly artifact for the Zelda library.
        Consumers depend only on this artifact — it bundles all Zelda modules
        and third-party deps, relocated to avoid classpath conflicts.
    </description>

    <dependencies>

        <!-- ── Zelda modules ──────────────────────────────────── -->
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-core</artifactId>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-paper</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-velocity</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-database</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-configuration</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-messaging</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-ui</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-injection</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-outbox</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.kgomc.zelda</groupId>
            <artifactId>zelda-bus</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── Third-party — shaded and relocated ─────────────── -->

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.reactivex.rxjava3</groupId>
            <artifactId>rxjava</artifactId>
        </dependency>
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
            <version>${nats.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ── JDBC Drivers — optional ────────────────────────── -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── ConfigLib ──────────────────────────────────────── -->
        <dependency>
            <groupId>de.exlll</groupId>
            <artifactId>configlib-yaml</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>de.exlll</groupId>
            <artifactId>configlib-paper</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── Injection ──────────────────────────────────────── -->
        <dependency>
            <groupId>org.codejargon.feather</groupId>
            <artifactId>feather</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
            <optional>true</optional>
        </dependency>

        <!-- ── Platform APIs — NOT shaded (provided at runtime) ── -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ── Testing ────────────────────────────────────────── -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>

                            <relocations>
                                <!-- HikariCP -->
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.hikari</shadedPattern>
                                </relocation>
                                <!-- Gson -->
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.gson</shadedPattern>
                                </relocation>
                                <!-- RxJava + ReactiveStreams -->
                                <relocation>
                                    <pattern>io.reactivex.rxjava3</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.rxjava3</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.reactivestreams</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.reactivestreams</shadedPattern>
                                </relocation>
                                <!-- NATS -->
                                <relocation>
                                    <pattern>io.nats</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.nats</shadedPattern>
                                </relocation>
                                <!-- ConfigLib -->
                                <relocation>
                                    <pattern>de.exlll.configlib</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.configlib</shadedPattern>
                                </relocation>
                                <!-- Feather DI -->
                                <relocation>
                                    <pattern>org.codejargon.feather</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.feather</shadedPattern>
                                </relocation>
                                <!-- JSR-330 -->
                                <relocation>
                                    <pattern>javax.inject</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.inject</shadedPattern>
                                </relocation>
                                <!-- SLF4J (pulled in by HikariCP + jnats) -->
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>net.kgomc.zelda.libs.slf4j</shadedPattern>
                                </relocation>
                            </relocations>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>